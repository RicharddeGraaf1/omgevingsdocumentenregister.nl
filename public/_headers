/*
  # Altijd hervalideren. Deze site heeft geen buildstap, dus zit er geen hash
  # in de bestandsnamen — cachet een bezoeker app.js, dan houdt hij de oude
  # versie ook nadat er een fix live staat. Dat is op 2026-08-04 precies
  # misgegaan: de documentdetail-fix was uitgerold, maar de browser draaide nog
  # de vorige versie en gaf 404 op elk document.
  # Met een ETag is hervalideren een 304 van een paar honderd bytes; dat is de
  # juiste ruil zolang assets niet versioned zijn.
  #
  # LET OP: op het custom domein landt de max-age hieronder (nog) niet — de
  # zone-instelling Browser Cache TTL staat op 4 uur en herschrijft hem naar
  # max-age=14400. Op <project>.pages.dev werkt hij wél; zo is op 2026-08-07
  # vastgesteld dat het de zone is en niet Pages. Zie CLAUDE.md voor de knop.
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://service.pdok.nl; connect-src 'self' https://annotatieconformiteit.nl https://ponsenkaart.nl https://instructieregels.nl https://dso-implementatiemonitor.nl; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
